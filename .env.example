# Discord Bot Configuration
# Get these from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here

# Twitch Application Configuration
# Get these from: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# OAuth Configuration
# For development: http://localhost:3000/auth/callback
# For production: https://your-app-name.herokuapp.com/auth/callback
TWITCH_CALLBACK_URL=http://localhost:3000/auth/callback

# Twitch OAuth Scopes (do not change unless you know what you're doing)
SCOPE=channel:read:redemptions+bits:read+channel:read:subscriptions

# Database Configuration
# For local development, use PostgreSQL connection string:
# postgresql://username:password@localhost:5432/database_name
# For Heroku, this is automatically set by the postgresql addon
DATABASE_URL=postgresql://username:password@localhost:5432/discord_bot

# Environment Mode
# Set to 'development' for local development (uses ngrok for webhooks)
# Set to 'production' for production deployment (uses Heroku hostname)
NODE_ENV=development

# Application Name
# For Heroku deployments: Your Heroku app name
# Used for keep-alive pings and EventSub webhook hostname
APP_NAME=your-heroku-app-name

# Optional: Additional Configuration
# Uncomment and configure if needed

# Logging Level (optional)
# LOG_LEVEL=info

# Database Pool Size (optional, default is 5)
# DB_POOL_SIZE=10

# Timezone for Cron Jobs (optional, default is UTC)
# CRON_TIMEZONE=Europe/Berlin

# Keep-Alive Ping Interval (optional, in minutes, default is 10)
# PING_INTERVAL=10
